{
  // tsconfig.json compiles what ships, so it includes only src/ and sets a
  // rootDir. This is the second pass that type-checks test/ as well, so a type
  // error in the suite fails `npm run check` rather than waiting until it runs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
